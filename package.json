{
  "name": "WhiteLabelApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node scripts/clientRun.js android",
    "ios": "node scripts/clientRun.js ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/clientRun.js start",
    "test": "jest",
    "client:create": "node scripts/clientCreate.js",
    "client:list": "node scripts/clientList.js",
    "client:validate": "node scripts/clientValidate.js",
    "client:prepare": "node scripts/clientPrepare.js",
    "android:demo": "node scripts/clientPrepare.js --client demo --environment development && npx react-native run-android",
    "android:build:demo": "node scripts/clientPrepare.js --client demo --environment development --skip-ios && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-onesignal": "^5.5.6",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "globals": "^17.9.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
